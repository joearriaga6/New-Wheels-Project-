-- Question 1 

SELECT 
	COUNT(DISTINCT(customer_id)) AS total_customers
FROM order_t; 

SELECT 
	state,
    COUNT(customer_id) AS total_customers
FROM customer_t
GROUP BY state 
ORDER BY total_customers DESC; 

-- Question 2

SELECT 
	vehicle_maker,
	COUNT(customer_t.customer_id) AS customer_count
FROM product_t
JOIN order_t
ON product_t.product_id = order_t.product_id
JOIN customer_t
ON order_t.customer_id = customer_t.customer_id
GROUP BY vehicle_maker
ORDER BY customer_count DESC
LIMIT 5;

-- Question 3

SELECT * 
FROM  
( 
SELECT  
state, 
vehicle_maker, 
COUNT(customer_id) AS total_customers, 
RANK() OVER (PARTITION BY state ORDER BY COUNT(customer_id) DESC) AS vehicle_ranking 
FROM product_t 
JOIN order_t USING (product_id) 
JOIN customer_t USING (customer_id) 
GROUP BY state, vehicle_maker 
) 
AS perferred_vehicle 
WHERE vehicle_ranking = 1 
ORDER BY total_customers DESC;

-- Question 4

WITH customer_rating AS ( 
SELECT 
customer_feedback, 
quarter_number, 
CASE WHEN customer_feedback = 'very bad' THEN '1' 
WHEN customer_feedback = 'bad' THEN '2' 
WHEN customer_feedback = 'okay' THEN '3' 
WHEN customer_feedback = 'good' THEN '4' 
WHEN customer_feedback = 'very good' THEN '5' 
END AS total_rating 
FROM order_t 
) 
SELECT  
ROUND(AVG(total_rating), 2) AS average_total_rating
FROM customer_rating; 
WITH customer_rating AS ( 
SELECT 
customer_feedback, 
quarter_number,                             
CASE WHEN customer_feedback = 'very bad' THEN '1' 
WHEN customer_feedback = 'bad' THEN '2' 
WHEN customer_feedback = 'okay' THEN '3' 
WHEN customer_feedback = 'good' THEN '4' 
WHEN customer_feedback = 'very good' THEN '5' 
END AS total_rating 
FROM order_t 
) 
SELECT  
quarter_number, 
ROUND(AVG(total_rating), 2) AS rating_per_quarter
FROM customer_rating  
GROUP BY quarter_number 
ORDER BY quarter_number;

-- Question 5

WITH feedback_customer AS ( 
SELECT  
quarter_number, 
SUM(CASE WHEN customer_feedback = 'Very Good' THEN 1 ELSE 0 END) AS VERY_GOOD, 
SUM(CASE WHEN customer_feedback = 'Good' THEN 1 ELSE 0 END) AS GOOD, 
SUM(CASE WHEN customer_feedback = 'Okay' THEN 1 ELSE 0 END) AS OKAY, 
SUM(CASE WHEN customer_feedback = 'Bad' THEN 1 ELSE 0 END) AS BAD, 
SUM(CASE WHEN customer_feedback = 'Very Bad' THEN 1 ELSE 0 END) AS VERY_BAD, 
COUNT(customer_feedback) AS FEEDBACK 
FROM order_t 
GROUP BY quarter_number 
ORDER BY quarter_number 
) 
SELECT 
quarter_number,  
ROUND((VERY_GOOD/FEEDBACK), 2) AS VERY_GOOD, 
ROUND((GOOD/FEEDBACK), 2) AS GOOD, 
ROUND((OKAY/FEEDBACK), 2) AS OKAY, 
ROUND((BAD/FEEDBACK), 2) AS BAD, 
ROUND((VERY_BAD/FEEDBACK), 2) AS VERY_BAD 
FROM feedback_customer 
GROUP BY quarter_number                     
ORDER BY quarter_number; 

